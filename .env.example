# .env.example
# ─────────────────────────────────────────────────────────────────────────────
# Environment variable configuration template.
#
# Copy this file to ".env" and fill in your values.
# The run-all.ps1 master script loads this file automatically.
#
# IMPORTANT: Do NOT commit your real .env file to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Dataverse / Power Platform ────────────────────────────────────────────────

# Your Dataverse environment URL (no trailing slash)
DATAVERSE_URL=https://orgab9ef392.crm.dynamics.com

# ── Azure AD / Service Principal ─────────────────────────────────────────────
# Used by migrate_data.py for Web API access.
# Create an app registration in Azure AD with Dataverse API permissions.

AZURE_TENANT_ID=63132fc0-ef63-45c4-a5bf-2c9fa8068a74
AZURE_CLIENT_ID=fd6735f7-d74e-4459-bd6b-c00f739e3399
AZURE_CLIENT_SECRET=your-client-secret-here

# ── Optional Overrides ────────────────────────────────────────────────────────

# Path to the Access database (default: ./input/Database3.accdb)
# ACCESS_DB_PATH=./input/Database3.accdb

# Dataverse solution name (default: AccessMigration)
# SOLUTION_NAME=AccessMigration

# Publisher prefix (default: auto)
# PUBLISHER_PREFIX=auto
